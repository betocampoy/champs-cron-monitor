{
    "name": "betocampoy/champs-cron-monitor",
    "description": "Monitoramento das rotinas do cron para projetos Symfony: wrapper com trava e log, histórico de execuções, agenda em YAML e painel administrativo.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Beto Campoy"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/console": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/yaml": "^7.4",
        "doctrine/orm": "^3.0",
        "doctrine/doctrine-bundle": "^2.13",
        "dragonmantank/cron-expression": "^3.3",
        "betocampoy/champs-frontend": "^1.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BetoCampoy\\Champs\\CronMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BetoCampoy\\Champs\\CronMonitor\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/champs-cron.sh"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
