{% extends layout %}

{% trans_default_domain 'champs_cron_monitor' %}

{% block title %}{{ 'title'|trans }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h4 m-0" data-champs-tour="page-title">{{ 'title'|trans }}</h1>
    <small class="text-muted" data-champs-tour="cron-updated-at">
        <i class="bi bi-arrow-repeat"></i>
        {{ 'updated_at'|trans }} <span id="champs-cron-updated-at">{{ updatedAt|date('H:i:s') }}</span>
    </small>
</div>

{# Elemento do AjaxPoll: fica sempre na tela; a resposta só reescreve as seções de dentro.
   Âncoras de tour guiado (champs-onboarding): page-title, cron-updated-at, cron-jobs, cron-queues,
   cron-workers e, na primeira linha da tabela, cron-job-status e cron-job-log. #}
<div data-champs-ajax-poll="{{ pollMs }}"
     data-champs-ajax-route="{{ path('champs_cron_monitor_status') }}">

    <div class="card mb-3" data-champs-tour="cron-jobs">
        <div class="card-header fw-semibold">{{ 'jobs.title'|trans }}</div>
        {% include '@ChampsCronMonitor/admin/_jobs.html.twig' %}
    </div>

    {% if messengerEnabled %}
        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card h-100" data-champs-tour="cron-queues">
                    <div class="card-header fw-semibold">{{ 'queues.title'|trans }}</div>
                    {% include '@ChampsCronMonitor/admin/_queues.html.twig' %}
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card h-100" data-champs-tour="cron-workers">
                    <div class="card-header fw-semibold">{{ 'workers.title'|trans }}</div>
                    {% include '@ChampsCronMonitor/admin/_workers.html.twig' %}
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
